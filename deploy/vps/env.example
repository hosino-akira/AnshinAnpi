# VPS の私有ファイルへコピーし、chmod 600 でアクセスを制限します。
# docker compose --env-file にそのパスを渡し、VPS_ENV_FILE も指定します。
# VPS_ENV_FILE=/home/debian/.config/anshin-anpi/runtime.env
# scripts/package-vps.ps1 が表示するリリースタグを使用します。
VPS_IMAGE_TAG=
POSTGRES_DB=anshin
POSTGRES_USER=anshin
POSTGRES_PASSWORD=
CORS_ORIGINS=https://anshin.info

# 本番 API には KMS が必須です。Secrets Manager は任意です。
AWS_REGION=
# 未指定の場合、Rekognition にも AWS_REGION を使用します。
# AWS_REKOGNITION_REGION=ap-northeast-1
AWS_REKOGNITION_COLLECTION_ID=
AWS_KMS_KEY_ARN=
# 空欄の場合、この私有環境変数ファイルに記載した秘密情報を使用します。
AWS_SECRET_ARN=
# VPS の AWS 認証方式を準備してから設定します。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS_SECRET_ARN が空欄の場合、Base64 形式の 32 バイトの秘密キーを設定します。
# 移行時も既存のキーを維持し、このファイルをイメージへ含めないでください。
# 署名済みの監査記録を移行する場合も AUDIT_HMAC_KEY を維持します。
TEMPORARY_ENCRYPTION_KEY=
AUDIT_HMAC_KEY=

SMTP_HOST=miteken.sakura.ne.jp
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=anshin@anshin.info
SMTP_PASSWORD=
SMTP_FROM_EMAIL=anshin@anshin.info
SMTP_REPLY_TO_EMAIL=
SERVICE_CONTACT=
FACILITY_NAME=
MAIL_WORKER_ENABLED=true

# SMTP の退信を TLS 接続の読み取り専用 IMAP で定期取得します。
# このメールボックスに SMTP_FROM_EMAIL の退信が届くことを確認してから有効にします。
# IMAP のホスト・ユーザーが空欄の場合は SMTP の設定を使い、パスワード省略時は SMTP_PASSWORD を使用します。
MAIL_BOUNCE_ENABLED=false
MAIL_BOUNCE_IMAP_HOST=
MAIL_BOUNCE_IMAP_PORT=993
MAIL_BOUNCE_IMAP_USER=
MAIL_BOUNCE_IMAP_MAILBOX=INBOX
MAIL_BOUNCE_POLL_SECONDS=60
MAIL_BOUNCE_LOOKBACK_DAYS=7
