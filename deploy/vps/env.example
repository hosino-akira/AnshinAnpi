# Copy to a private file on the VPS and restrict access with chmod 600.
# Pass that path with docker compose --env-file and set VPS_ENV_FILE below.
# VPS_ENV_FILE=/home/debian/.config/anshin-anpi/runtime.env
# Use the release tag printed by scripts/package-vps.ps1.
VPS_IMAGE_TAG=
POSTGRES_DB=anshin
POSTGRES_USER=anshin
POSTGRES_PASSWORD=
CORS_ORIGINS=https://anshin.info

# The API requires KMS in production. Secrets Manager is optional.
AWS_REGION=
# Omit this override to use AWS_REGION for Rekognition as well.
# AWS_REKOGNITION_REGION=ap-northeast-1
AWS_REKOGNITION_COLLECTION_ID=
AWS_KMS_KEY_ARN=
# Leave empty to read the secrets below from this private environment file.
AWS_SECRET_ARN=
# Populate only after configuring the VPS's AWS authentication method.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Set these 32-byte base64 secrets here when AWS_SECRET_ARN is empty.
# Preserve existing keys during migration; never include this file in an image.
# Preserve AUDIT_HMAC_KEY when migrating existing signed audit records.
TEMPORARY_ENCRYPTION_KEY=
AUDIT_HMAC_KEY=

SMTP_HOST=miteken.sakura.ne.jp
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=anshin@anshin.info
SMTP_PASSWORD=
SMTP_FROM_EMAIL=anshin@anshin.info
SMTP_REPLY_TO_EMAIL=
SERVICE_CONTACT=
FACILITY_NAME=
MAIL_WORKER_ENABLED=true
