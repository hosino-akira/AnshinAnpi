# Copy to .env and replace the password before starting PostgreSQL.
POSTGRES_DB=anshin
POSTGRES_USER=anshin
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5433

# Run .\scripts\backend.ps1 -Action setup to generate local secrets.
API_PORT=3001
# Local development only: request/response and score logs, with photos and credentials redacted.
API_DEBUG_LOG_ENABLED=false
DATA_ENCRYPTION_MODE=local
DATA_ENCRYPTION_KEY=
TEMPORARY_ENCRYPTION_KEY=
AUDIT_HMAC_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fill these after creating AWS resources; use a local profile or an IAM role.
AWS_PROFILE=
AWS_REGION=
AWS_REKOGNITION_REGION=
AWS_REKOGNITION_COLLECTION_ID=
AWS_KMS_KEY_ARN=
# Optional: otherwise encryption/audit keys and SMTP_PASSWORD come from this file.
AWS_SECRET_ARN=
# SMTP mail settings. Port 587 uses required STARTTLS; port 465 uses implicit TLS.
# Use Sakura's initial domain for SMTP TLS; the sender address uses anshin.info.
SMTP_HOST=miteken.sakura.ne.jp
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=anshin@anshin.info
SMTP_PASSWORD=
SMTP_FROM_EMAIL=anshin@anshin.info
SMTP_REPLY_TO_EMAIL=
SERVICE_CONTACT=
# Official facility name shown in safety emails; blank uses ご利用施設.
FACILITY_NAME=
MAIL_WORKER_ENABLED=true
