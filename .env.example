# .env にコピーし、PostgreSQL の起動前にパスワードを設定してください。
POSTGRES_DB=anshin
POSTGRES_USER=anshin
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5433

# .\scripts\backend.ps1 -Action setup でローカルの秘密キーを生成します。
API_PORT=3001
# ローカル開発専用：要求・応答とスコアを記録し、写真と認証情報を遮蔽します。
API_DEBUG_LOG_ENABLED=false
DATA_ENCRYPTION_MODE=local
DATA_ENCRYPTION_KEY=
TEMPORARY_ENCRYPTION_KEY=
AUDIT_HMAC_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AWS リソースの作成後に設定し、ローカルプロファイルまたは IAM ロールを使用します。
AWS_PROFILE=
AWS_REGION=
AWS_REKOGNITION_REGION=
AWS_REKOGNITION_COLLECTION_ID=
AWS_KMS_KEY_ARN=
# 任意設定です。未設定の場合は、このファイルの暗号化・監査キーと SMTP_PASSWORD を使用します。
AWS_SECRET_ARN=
# SMTP 接続設定。587 は STARTTLS 必須、465 は接続開始時から TLS を使用します。
# TLS 接続にはさくらの初期ドメインを使い、送信元アドレスには anshin.info を使用します。
SMTP_HOST=miteken.sakura.ne.jp
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=anshin@anshin.info
SMTP_PASSWORD=
SMTP_FROM_EMAIL=anshin@anshin.info
SMTP_REPLY_TO_EMAIL=
SERVICE_CONTACT=
# 安否確認メールに表示する施設名です。空欄の場合は「ご利用施設」を使用します。
FACILITY_NAME=
MAIL_WORKER_ENABLED=true

# IMAP over TLS で SMTP の退信を監視します。接続確認後に有効にしてください。
# IMAP のホスト・ユーザー・パスワードが未設定の場合は SMTP の設定を再利用します。
MAIL_BOUNCE_ENABLED=false
MAIL_BOUNCE_IMAP_HOST=
MAIL_BOUNCE_IMAP_PORT=993
MAIL_BOUNCE_IMAP_USER=
# MAIL_BOUNCE_IMAP_PASSWORD を省略すると SMTP_PASSWORD を再利用します。
MAIL_BOUNCE_IMAP_MAILBOX=INBOX
MAIL_BOUNCE_POLL_SECONDS=60
MAIL_BOUNCE_LOOKBACK_DAYS=7
