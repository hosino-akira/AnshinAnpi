# 除外設定の参考：https://help.github.com/articles/ignoring-files/

# 依存関係
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 検証時の生成物
/coverage

# Next.js の生成物
/.next/
/out/

# その他の作業ファイル
.DS_Store
*.pem

# デバッグログ
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 環境変数（雛形だけを Git で管理）
.env*
!.env.example

# Vercel の作業データ
.vercel

# TypeScript とビルドの作業データ
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/
